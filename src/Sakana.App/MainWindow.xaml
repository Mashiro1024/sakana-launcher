<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Sakana.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Sakana.App"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Sakana Launcher"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid" RequestedTheme="Dark">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar
            x:Name="AppTitleBar"
            Title="Sakana Launcher"
            Subtitle="Java Edition"
            IsBackButtonVisible="False"
            IsPaneToggleButtonVisible="True"
            PaneToggleRequested="TitleBar_PaneToggleRequested">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="Assets/Square44x44Logo.scale-200.png" />
            </TitleBar.IconSource>
        </TitleBar>

        <NavigationView
            x:Name="NavView"
            Grid.Row="1"
            OpenPaneLength="224"
            CompactPaneLength="48"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            PaneDisplayMode="Left"
            IsSettingsVisible="True"
            Background="Transparent"
            PaneOpening="NavView_PaneOpening"
            PaneClosing="NavView_PaneClosing"
            SelectionChanged="NavView_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem
                    Content="首页"
                    IsSelected="True"
                    Tag="home">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Home" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="实例库" Tag="library">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Library" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="下载" Tag="downloads">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Download" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="日志" Tag="logs">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Bullets" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="截图" Tag="screenshots">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Pictures" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="账户" Tag="accounts">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Contact" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.PaneHeader>
                <StackPanel x:Name="PaneBrandHeader" Padding="14,10,12,10" Orientation="Horizontal" Spacing="10">
                    <Image Source="Assets/Square44x44Logo.scale-200.png" Width="28" Height="28" VerticalAlignment="Center" />
                    <StackPanel Spacing="1" VerticalAlignment="Center">
                        <TextBlock Text="SAKANA" FontSize="13" FontWeight="Bold" CharacterSpacing="90" Foreground="{ThemeResource SakanaTextBrush}" />
                        <TextBlock Text="MINECRAFT JAVA" FontSize="10" CharacterSpacing="60" Foreground="{ThemeResource SakanaMutedBrush}" />
                    </StackPanel>
                </StackPanel>
            </NavigationView.PaneHeader>
            <NavigationView.PaneFooter>
                <Button
                    x:Name="AccountFooterButton"
                    Margin="8,0,8,4"
                    Padding="8,7"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    Background="{ThemeResource SakanaSurfaceBrush}"
                    BorderBrush="{ThemeResource SakanaStrokeBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Click="AccountFooter_Click"
                    ToolTipService.ToolTip="查看或切换 Minecraft 账户">
                    <Grid ColumnSpacing="9">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="28" Height="28" CornerRadius="7" Background="{ThemeResource SakanaAccentSoftBrush}">
                            <TextBlock
                                x:Name="AccountFooterInitial"
                                Text="M"
                                FontSize="12"
                                FontWeight="SemiBold"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource SakanaAccentBrush}" />
                        </Border>
                        <StackPanel x:Name="AccountFooterMeta" Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                            <TextBlock
                                x:Name="AccountFooterName"
                                Text="未登录账户"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource SakanaTextBrush}"
                                TextTrimming="CharacterEllipsis" />
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <Grid Width="6" Height="6" VerticalAlignment="Center">
                                    <Ellipse x:Name="AccountDotMuted" Width="6" Height="6" Fill="{ThemeResource SakanaMutedBrush}" />
                                    <Ellipse x:Name="AccountDotReady" Width="6" Height="6" Fill="{ThemeResource SakanaSuccessBrush}" Visibility="Collapsed" />
                                    <Ellipse x:Name="AccountDotWarning" Width="6" Height="6" Fill="{ThemeResource SakanaWarningBrush}" Visibility="Collapsed" />
                                </Grid>
                                <TextBlock
                                    x:Name="AccountFooterStatus"
                                    Text="点击连接 Microsoft"
                                    FontSize="11"
                                    Foreground="{ThemeResource SakanaMutedBrush}"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Button>
            </NavigationView.PaneFooter>
            <Frame x:Name="NavFrame">
                <Frame.ContentTransitions>
                    <TransitionCollection>
                        <NavigationThemeTransition />
                    </TransitionCollection>
                </Frame.ContentTransitions>
            </Frame>
        </NavigationView>
    </Grid>
</Window>
