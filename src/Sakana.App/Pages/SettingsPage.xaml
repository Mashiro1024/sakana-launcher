<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Sakana.App.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Padding="32,24,32,28">
      <Grid RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <InfoBar x:Name="SavedInfoBar" IsOpen="False" Severity="Success" Message="设置已保存。" />

        <Grid Grid.Row="1">
            <ScrollViewer x:Name="SettingsHomePanel" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="14">
                    <StackPanel Spacing="4" Margin="0,0,0,8">
                        <TextBlock Text="设置" FontSize="32" FontWeight="SemiBold" Foreground="{ThemeResource SakanaTextBrush}" />
                        <TextBlock Text="管理 Sakana Launcher 的外观、游戏启动方式和本地数据。" FontSize="15" Foreground="{ThemeResource SakanaMutedBrush}" />
                    </StackPanel>

                    <TextBlock Text="个性化" FontSize="16" FontWeight="SemiBold" Foreground="{ThemeResource SakanaTextBrush}" />
                    <Button Tag="appearance" Click="OpenSettingsSection_Click" Padding="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Background="Transparent" BorderThickness="0">
                        <Border Padding="18,16" CornerRadius="10" Background="{ThemeResource SakanaSurfaceBrush}" BorderBrush="{ThemeResource SakanaStrokeBrush}" BorderThickness="1">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <SymbolIcon Symbol="Setting" Width="24" Height="24" VerticalAlignment="Center" Foreground="{ThemeResource SakanaTextBrush}" />
                                <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                    <TextBlock Text="外观" FontSize="16" FontWeight="SemiBold" Foreground="{ThemeResource SakanaTextBrush}" />
                                    <TextBlock Text="主题和浅色、深色模式" FontSize="13" Foreground="{ThemeResource SakanaMutedBrush}" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="›" FontSize="24" VerticalAlignment="Center" Foreground="{ThemeResource SakanaMutedBrush}" />
                            </Grid>
                        </Border>
                    </Button>

                    <TextBlock Text="游戏" FontSize="16" FontWeight="SemiBold" Foreground="{ThemeResource SakanaTextBrush}" Margin="0,8,0,0" />
                    <Button Tag="java-memory" Click="OpenSettingsSection_Click" Padding="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Background="Transparent" BorderThickness="0">
                        <Border Padding="18,16" CornerRadius="10" Background="{ThemeResource SakanaSurfaceBrush}" BorderBrush="{ThemeResource SakanaStrokeBrush}" BorderThickness="1">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <SymbolIcon Symbol="Play" Width="24" Height="24" VerticalAlignment="Center" Foreground="{ThemeResource SakanaTextBrush}" />
                                <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                    <TextBlock Text="Java 和内存" FontSize="16" FontWeight="SemiBold" Foreground="{ThemeResource SakanaTextBrush}" />
                                    <TextBlock Text="自动分配、Java 运行时和启动参数" FontSize="13" Foreground="{ThemeResource SakanaMutedBrush}" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="›" FontSize="24" VerticalAlignment="Center" Foreground="{ThemeResource SakanaMutedBrush}" />
                            </Grid>
                        </Border>
                    </Button>
                    <Button Tag="game-window" Click="OpenSettingsSection_Click" Padding="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Background="Transparent" BorderThickness="0">
                        <Border Padding="18,16" CornerRadius="10" Background="{ThemeResource SakanaSurfaceBrush}" BorderBrush="{ThemeResource SakanaStrokeBrush}" BorderThickness="1">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <SymbolIcon Symbol="FullScreen" Width="24" Height="24" VerticalAlignment="Center" Foreground="{ThemeResource SakanaTextBrush}" />
                                <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                    <TextBlock Text="游戏窗口" FontSize="16" FontWeight="SemiBold" Foreground="{ThemeResource SakanaTextBrush}" />
                                    <TextBlock Text="全屏启动和默认窗口尺寸" FontSize="13" Foreground="{ThemeResource SakanaMutedBrush}" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="›" FontSize="24" VerticalAlignment="Center" Foreground="{ThemeResource SakanaMutedBrush}" />
                            </Grid>
                        </Border>
                    </Button>

                    <TextBlock Text="系统" FontSize="16" FontWeight="SemiBold" Foreground="{ThemeResource SakanaTextBrush}" Margin="0,8,0,0" />
                    <Button Tag="downloads" Click="OpenSettingsSection_Click" Padding="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Background="Transparent" BorderThickness="0">
                        <Border Padding="18,16" CornerRadius="10" Background="{ThemeResource SakanaSurfaceBrush}" BorderBrush="{ThemeResource SakanaStrokeBrush}" BorderThickness="1">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <SymbolIcon Symbol="Download" Width="24" Height="24" VerticalAlignment="Center" Foreground="{ThemeResource SakanaTextBrush}" />
                                <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                    <TextBlock Text="下载" FontSize="16" FontWeight="SemiBold" Foreground="{ThemeResource SakanaTextBrush}" />
                                    <TextBlock Text="同时并行下载的文件数（1–256）" FontSize="13" Foreground="{ThemeResource SakanaMutedBrush}" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="›" FontSize="24" VerticalAlignment="Center" Foreground="{ThemeResource SakanaMutedBrush}" />
                            </Grid>
                        </Border>
                    </Button>
                    <Button Tag="curseforge" Click="OpenSettingsSection_Click" Padding="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Background="Transparent" BorderThickness="0">
                        <Border Padding="18,16" CornerRadius="10" Background="{ThemeResource SakanaSurfaceBrush}" BorderBrush="{ThemeResource SakanaStrokeBrush}" BorderThickness="1">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <SymbolIcon Symbol="Library" Width="24" Height="24" VerticalAlignment="Center" Foreground="{ThemeResource SakanaTextBrush}" />
                                <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                    <TextBlock Text="CurseForge" FontSize="16" FontWeight="SemiBold" Foreground="{ThemeResource SakanaTextBrush}" />
                                    <TextBlock Text="API Key 与第三方内容接入" FontSize="13" Foreground="{ThemeResource SakanaMutedBrush}" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="›" FontSize="24" VerticalAlignment="Center" Foreground="{ThemeResource SakanaMutedBrush}" />
                            </Grid>
                        </Border>
                    </Button>
                    <Button Tag="data" Click="OpenSettingsSection_Click" Padding="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Background="Transparent" BorderThickness="0">
                        <Border Padding="18,16" CornerRadius="10" Background="{ThemeResource SakanaSurfaceBrush}" BorderBrush="{ThemeResource SakanaStrokeBrush}" BorderThickness="1">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <SymbolIcon Symbol="Folder" Width="24" Height="24" VerticalAlignment="Center" Foreground="{ThemeResource SakanaTextBrush}" />
                                <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                    <TextBlock Text="本地数据" FontSize="16" FontWeight="SemiBold" Foreground="{ThemeResource SakanaTextBrush}" />
                                    <TextBlock Text="查看 Sakana 配置、实例和运行时所在位置" FontSize="13" Foreground="{ThemeResource SakanaMutedBrush}" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="›" FontSize="24" VerticalAlignment="Center" Foreground="{ThemeResource SakanaMutedBrush}" />
                            </Grid>
                        </Border>
                    </Button>
                    <Button Tag="about" Click="OpenSettingsSection_Click" Padding="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Background="Transparent" BorderThickness="0">
                        <Border Padding="18,16" CornerRadius="10" Background="{ThemeResource SakanaSurfaceBrush}" BorderBrush="{ThemeResource SakanaStrokeBrush}" BorderThickness="1">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <SymbolIcon Symbol="Help" Width="24" Height="24" VerticalAlignment="Center" Foreground="{ThemeResource SakanaTextBrush}" />
                                <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                    <TextBlock Text="关于" FontSize="16" FontWeight="SemiBold" Foreground="{ThemeResource SakanaTextBrush}" />
                                    <TextBlock Text="版本和产品信息" FontSize="13" Foreground="{ThemeResource SakanaMutedBrush}" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="›" FontSize="24" VerticalAlignment="Center" Foreground="{ThemeResource SakanaMutedBrush}" />
                            </Grid>
                        </Border>
                    </Button>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="AppearancePanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="16">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button Content="设置" Click="BackToSettings_Click" Padding="0" Background="Transparent" BorderThickness="0" Foreground="{ThemeResource SakanaMutedBrush}" />
                        <TextBlock Text="›" FontSize="22" Foreground="{ThemeResource SakanaMutedBrush}" />
                        <TextBlock Text="个性化" FontSize="27" FontWeight="SemiBold" Foreground="{ThemeResource SakanaTextBrush}" />
                    </StackPanel>
                    <TextBlock Text="外观" FontSize="16" FontWeight="SemiBold" Foreground="{ThemeResource SakanaTextBrush}" />
                    <Border Padding="18" CornerRadius="10" Background="{ThemeResource SakanaSurfaceBrush}" BorderBrush="{ThemeResource SakanaStrokeBrush}" BorderThickness="1">
                        <Grid ColumnSpacing="24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="260" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="4" VerticalAlignment="Center">
                                <TextBlock Text="应用主题" FontSize="17" FontWeight="SemiBold" Foreground="{ThemeResource SakanaTextBrush}" />
                                <TextBlock Text="选择深色、浅色，或跟随 Windows 设置。" FontSize="13" Foreground="{ThemeResource SakanaMutedBrush}" />
                            </StackPanel>
                            <ComboBox x:Name="ThemeCombo" Grid.Column="1" SelectionChanged="ThemeCombo_SelectionChanged" VerticalAlignment="Center" HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="跟随 Windows" Tag="System" />
                                <ComboBoxItem Content="深色" Tag="Dark" />
                                <ComboBoxItem Content="浅色" Tag="Light" />
                            </ComboBox>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="JavaMemoryPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="14">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button Content="设置" Click="BackToSettings_Click" Padding="0" Background="Transparent" BorderThickness="0" Foreground="{ThemeResource SakanaMutedBrush}" />
                        <TextBlock Text="›" FontSize="22" Foreground="{ThemeResource SakanaMutedBrush}" />
                        <TextBlock Text="游戏" FontSize="27" FontWeight="SemiBold" Foreground="{ThemeResource SakanaMutedBrush}" />
                        <TextBlock Text="›" FontSize="22" Foreground="{ThemeResource SakanaMutedBrush}" />
                        <TextBlock Text="Java 和内存" FontSize="27" FontWeight="SemiBold" Foreground="{ThemeResource SakanaTextBrush}" />
                    </StackPanel>
                    <TextBlock Text="这些默认值会用于跟随全局设置的新实例；单个实例可以覆盖它们。" FontSize="13" TextWrapping="Wrap" Foreground="{ThemeResource SakanaMutedBrush}" />
                    <Border Padding="18" CornerRadius="10" Background="{ThemeResource SakanaSurfaceBrush}" BorderBrush="{ThemeResource SakanaStrokeBrush}" BorderThickness="1">
                        <StackPanel Spacing="10">
                            <TextBlock Text="内存" FontSize="16" FontWeight="SemiBold" Foreground="{ThemeResource SakanaTextBrush}" />
                            <ToggleSwitch x:Name="GlobalAutomaticMemoryToggle" Header="自动分配内存" OnContent="自动" OffContent="手动" Toggled="GlobalAutomaticMemoryToggle_Toggled" />
                            <TextBlock Text="自动模式会在每次启动时按设备可供 Java 使用的内存计算堆上限（1–16 GB）；游戏运行后不会热调整。手动模式使用下方的最小和最大值。" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource SakanaMutedBrush}" />
                            <NumberBox x:Name="GlobalMinMemoryInput" Header="最小内存（MB）" Minimum="256" Maximum="65536" SmallChange="256" LargeChange="1024" SpinButtonPlacementMode="Inline" />
                            <NumberBox x:Name="GlobalMaxMemoryInput" Header="最大内存（MB）" Minimum="256" Maximum="65536" SmallChange="256" LargeChange="1024" SpinButtonPlacementMode="Inline" />
                        </StackPanel>
                    </Border>
                    <Border Padding="18" CornerRadius="10" Background="{ThemeResource SakanaSurfaceBrush}" BorderBrush="{ThemeResource SakanaStrokeBrush}" BorderThickness="1">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Java 运行时" FontSize="16" FontWeight="SemiBold" Foreground="{ThemeResource SakanaTextBrush}" />
                            <ToggleSwitch x:Name="GlobalCustomJavaToggle" Header="选择 Java 运行时" OnContent="自定义" OffContent="自动检测" Toggled="GlobalCustomJavaToggle_Toggled" />
                            <TextBlock Text="自动模式按 Minecraft 版本选择兼容的 Java 主版本：优先使用本机匹配版本；找不到时再下载 Mojang 管理的运行时。" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource SakanaMutedBrush}" />
                            <TextBox x:Name="GlobalJavaPathInput" Header="Java 可执行文件" PlaceholderText="选择检测到的版本，或浏览 java.exe" IsEnabled="False" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Name="BrowseGlobalJavaButton" Content="浏览 java.exe" Click="BrowseGlobalJava_Click" IsEnabled="False" />
                                <Button Tag="java-runtimes" Content="管理已安装 Java 和下载" Click="OpenSettingsSection_Click" />
                                <Button x:Name="UseAutomaticJavaButton" Content="自动匹配" Click="UseAutomaticJava_Click" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Padding="18" CornerRadius="10" Background="{ThemeResource SakanaSurfaceBrush}" BorderBrush="{ThemeResource SakanaStrokeBrush}" BorderThickness="1">
                        <StackPanel Spacing="10">
                            <TextBlock Text="高级启动参数" FontSize="16" FontWeight="SemiBold" Foreground="{ThemeResource SakanaTextBrush}" />
                            <TextBox x:Name="GlobalJavaArgumentsInput" Header="自定义 Java 参数" PlaceholderText="例如：-XX:+UseG1GC -XX:+UnlockExperimentalVMOptions" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60" />
                            <TextBox x:Name="GlobalEnvironmentVariablesInput" Header="自定义环境变量" PlaceholderText="每行一项，例如：&#10;MALLOC_ARENA_MAX=2&#10;JAVA_TOOL_OPTIONS=-Dfile.encoding=UTF-8" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="80" />
                        </StackPanel>
                    </Border>
                    <Button Content="保存 Java 和内存设置" Click="SaveGlobalLaunchSettings_Click" HorizontalAlignment="Right" Padding="14,8" Style="{ThemeResource AccentButtonStyle}" FontWeight="SemiBold" />
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="JavaRuntimesPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="14">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button Content="设置" Click="BackToSettings_Click" Padding="0" Background="Transparent" BorderThickness="0" Foreground="{ThemeResource SakanaMutedBrush}" />
                        <TextBlock Text="›" FontSize="22" Foreground="{ThemeResource SakanaMutedBrush}" />
                        <TextBlock Text="游戏" FontSize="27" FontWeight="SemiBold" Foreground="{ThemeResource SakanaMutedBrush}" />
                        <TextBlock Text="›" FontSize="22" Foreground="{ThemeResource SakanaMutedBrush}" />
                        <TextBlock Text="Java 运行时" FontSize="27" FontWeight="SemiBold" Foreground="{ThemeResource SakanaTextBrush}" />
                    </StackPanel>
                    <TextBlock Text="检查本机所有常见安装位置，查看 Java 路径和版本；也可以下载 Minecraft 常用的 Mojang 官方运行时。" FontSize="13" TextWrapping="Wrap" Foreground="{ThemeResource SakanaMutedBrush}" />

                    <Border Padding="18" CornerRadius="10" Background="{ThemeResource SakanaSurfaceBrush}" BorderBrush="{ThemeResource SakanaStrokeBrush}" BorderThickness="1">
                        <StackPanel Spacing="12">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="4" VerticalAlignment="Center">
                                    <TextBlock Text="本机已安装的 Java" FontSize="16" FontWeight="SemiBold" Foreground="{ThemeResource SakanaTextBrush}" />
                                    <TextBlock x:Name="JavaDetectionStatusText" Text="正在准备检测…" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource SakanaMutedBrush}" />
                                </StackPanel>
                                <Button x:Name="DetectJavaButton" Grid.Column="1" Content="重新检测" Click="DetectJava_Click" VerticalAlignment="Center" />
                            </Grid>
                            <ProgressRing x:Name="JavaDetectionProgressRing" IsActive="False" Width="24" Height="24" HorizontalAlignment="Left" />
                            <StackPanel x:Name="InstalledJavaListPanel" Spacing="8" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="下载 Minecraft 常用 Java" FontSize="16" FontWeight="SemiBold" Foreground="{ThemeResource SakanaTextBrush}" Margin="0,8,0,0" />
                    <TextBlock Text="下载的运行时保存在 Sakana 数据目录中。自动匹配模式会在 Minecraft 需要对应版本时使用它。" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource SakanaMutedBrush}" />
                    <StackPanel x:Name="JavaDownloadOptionsPanel" Spacing="8" />
                    <ProgressBar x:Name="JavaDownloadProgressBar" Visibility="Collapsed" Minimum="0" Maximum="100" Value="0" />
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="JavaDownloadStatusText" VerticalAlignment="Center" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource SakanaMutedBrush}" />
                        <Button x:Name="CancelJavaRuntimeDownloadButton" Grid.Column="1" Content="取消下载" Click="CancelJavaRuntimeDownload_Click" Visibility="Collapsed" />
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="GameWindowPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="14">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button Content="设置" Click="BackToSettings_Click" Padding="0" Background="Transparent" BorderThickness="0" Foreground="{ThemeResource SakanaMutedBrush}" />
                        <TextBlock Text="›" FontSize="22" Foreground="{ThemeResource SakanaMutedBrush}" />
                        <TextBlock Text="游戏" FontSize="27" FontWeight="SemiBold" Foreground="{ThemeResource SakanaMutedBrush}" />
                        <TextBlock Text="›" FontSize="22" Foreground="{ThemeResource SakanaMutedBrush}" />
                        <TextBlock Text="游戏窗口" FontSize="27" FontWeight="SemiBold" Foreground="{ThemeResource SakanaTextBrush}" />
                    </StackPanel>
                    <TextBlock Text="配置新实例默认使用的游戏窗口模式和尺寸。" FontSize="13" Foreground="{ThemeResource SakanaMutedBrush}" />
                    <Border Padding="18" CornerRadius="10" Background="{ThemeResource SakanaSurfaceBrush}" BorderBrush="{ThemeResource SakanaStrokeBrush}" BorderThickness="1">
                        <StackPanel Spacing="10">
                            <TextBlock Text="窗口模式" FontSize="16" FontWeight="SemiBold" Foreground="{ThemeResource SakanaTextBrush}" />
                            <ToggleSwitch x:Name="GlobalFullscreenToggle" Header="全屏启动" OnContent="全屏" OffContent="窗口" Toggled="GlobalFullscreenToggle_Toggled" />
                            <NumberBox x:Name="GlobalWindowWidthInput" Header="窗口宽度" Minimum="640" Maximum="16384" SmallChange="16" LargeChange="100" SpinButtonPlacementMode="Inline" />
                            <NumberBox x:Name="GlobalWindowHeightInput" Header="窗口高度" Minimum="480" Maximum="16384" SmallChange="16" LargeChange="100" SpinButtonPlacementMode="Inline" />
                        </StackPanel>
                    </Border>
                    <Button Content="保存游戏窗口设置" Click="SaveGlobalLaunchSettings_Click" HorizontalAlignment="Right" Padding="14,8" Style="{ThemeResource AccentButtonStyle}" FontWeight="SemiBold" />
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="DownloadSettingsPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="14">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button Content="设置" Click="BackToSettings_Click" Padding="0" Background="Transparent" BorderThickness="0" Foreground="{ThemeResource SakanaMutedBrush}" />
                        <TextBlock Text="›" FontSize="22" Foreground="{ThemeResource SakanaMutedBrush}" />
                        <TextBlock Text="下载" FontSize="27" FontWeight="SemiBold" Foreground="{ThemeResource SakanaTextBrush}" />
                    </StackPanel>
                    <TextBlock Text="设置 Sakana 下载游戏文件、Java 运行时和 Modrinth 内容时使用的并发数。" FontSize="13" TextWrapping="Wrap" Foreground="{ThemeResource SakanaMutedBrush}" />
                    <Border Padding="18" CornerRadius="10" Background="{ThemeResource SakanaSurfaceBrush}" BorderBrush="{ThemeResource SakanaStrokeBrush}" BorderThickness="1">
                        <StackPanel Spacing="12">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="最多并行下载文件数" FontSize="16" FontWeight="SemiBold" Foreground="{ThemeResource SakanaTextBrush}" />
                                    <TextBlock Text="保存后立即影响下载队列；已开始的文件继续下载，后续文件按新上限排队。" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource SakanaMutedBrush}" />
                                </StackPanel>
                                <Border Grid.Column="1" Padding="12,6" CornerRadius="8" Background="{ThemeResource SakanaSurfaceRaisedBrush}" VerticalAlignment="Center">
                                    <TextBlock x:Name="DownloadConcurrencyValueText" Text="8 个文件" FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource SakanaTextBrush}" />
                                </Border>
                            </Grid>
                            <Slider x:Name="DownloadConcurrencySlider" Minimum="1" Maximum="256" StepFrequency="1" TickFrequency="16" TickPlacement="Outside" ValueChanged="DownloadConcurrencySlider_ValueChanged" />
                            <Grid ColumnSpacing="0" Margin="0,-4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="15*" />
                                    <ColumnDefinition Width="16*" />
                                    <ColumnDefinition Width="32*" />
                                    <ColumnDefinition Width="64*" />
                                    <ColumnDefinition Width="64*" />
                                    <ColumnDefinition Width="64*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="1" FontSize="11" HorizontalAlignment="Left" Foreground="{ThemeResource SakanaMutedBrush}" />
                                <TextBlock Grid.Column="0" Text="16" FontSize="11" HorizontalAlignment="Right" Foreground="{ThemeResource SakanaMutedBrush}" />
                                <TextBlock Grid.Column="1" Text="32" FontSize="11" TextAlignment="Right" Foreground="{ThemeResource SakanaMutedBrush}" />
                                <TextBlock Grid.Column="2" Text="64" FontSize="11" TextAlignment="Right" Foreground="{ThemeResource SakanaMutedBrush}" />
                                <TextBlock Grid.Column="3" Text="128" FontSize="11" TextAlignment="Right" Foreground="{ThemeResource SakanaMutedBrush}" />
                                <TextBlock Grid.Column="4" Text="192" FontSize="11" TextAlignment="Right" Foreground="{ThemeResource SakanaMutedBrush}" />
                                <TextBlock Grid.Column="5" Text="256" FontSize="11" TextAlignment="Right" Foreground="{ThemeResource SakanaMutedBrush}" />
                            </Grid>
                            <TextBlock Text="更高并发会同时建立更多连接，可能占满带宽或触发下载源限流。大文件仍按文件整体下载，不会拆成多个分段连接。" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource SakanaMutedBrush}" />
                        </StackPanel>
                    </Border>
                    <Button Content="保存下载设置" Click="SaveDownloadConcurrency_Click" HorizontalAlignment="Right" Padding="14,8" Style="{ThemeResource AccentButtonStyle}" FontWeight="SemiBold" />
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="DataPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="16">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button Content="设置" Click="BackToSettings_Click" Padding="0" Background="Transparent" BorderThickness="0" Foreground="{ThemeResource SakanaMutedBrush}" />
                        <TextBlock Text="›" FontSize="22" Foreground="{ThemeResource SakanaMutedBrush}" />
                        <TextBlock Text="本地数据" FontSize="27" FontWeight="SemiBold" Foreground="{ThemeResource SakanaTextBrush}" />
                    </StackPanel>
                    <TextBlock Text="查看 Sakana 保存配置、实例和运行时的位置。" FontSize="13" Foreground="{ThemeResource SakanaMutedBrush}" />
                    <TextBlock Text="存储" FontSize="16" FontWeight="SemiBold" Foreground="{ThemeResource SakanaTextBrush}" />
                    <Border Padding="18" CornerRadius="10" Background="{ThemeResource SakanaSurfaceBrush}" BorderBrush="{ThemeResource SakanaStrokeBrush}" BorderThickness="1">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Sakana 数据目录" FontSize="16" FontWeight="SemiBold" Foreground="{ThemeResource SakanaTextBrush}" />
                            <TextBlock Text="主题、实例配置、游戏文件和 Java 运行时保存在此设备上。" FontSize="13" Foreground="{ThemeResource SakanaMutedBrush}" />
                            <TextBox x:Name="DataDirectoryText" IsReadOnly="True" IsTabStop="True" />
                            <TextBlock Text="卸载或迁移前，请先备份此目录。" FontSize="12" Foreground="{ThemeResource SakanaMutedBrush}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="CurseForgePanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="16">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button Content="设置" Click="BackToSettings_Click" Padding="0" Background="Transparent" BorderThickness="0" Foreground="{ThemeResource SakanaMutedBrush}" />
                        <TextBlock Text="›" FontSize="22" Foreground="{ThemeResource SakanaMutedBrush}" />
                        <TextBlock Text="CurseForge" FontSize="27" FontWeight="SemiBold" Foreground="{ThemeResource SakanaTextBrush}" />
                    </StackPanel>
                    <TextBlock Text="配置你自己的 CurseForge API Key，用于解析和安装 CurseForge 整合包中的托管文件。API Key 由 CurseForge 审核后发放，并通过 Windows DPAPI 加密保存在当前 Windows 用户下。" FontSize="13" TextWrapping="Wrap" Foreground="{ThemeResource SakanaMutedBrush}" />
                    <Border Padding="18" CornerRadius="10" Background="{ThemeResource SakanaSurfaceBrush}" BorderBrush="{ThemeResource SakanaStrokeBrush}" BorderThickness="1">
                        <StackPanel Spacing="12">
                            <TextBlock Text="API Key" FontSize="16" FontWeight="SemiBold" Foreground="{ThemeResource SakanaTextBrush}" />
                            <InfoBar x:Name="CurseForgeKeyStatusInfoBar" IsOpen="True" IsClosable="False" Severity="Informational" Message="尚未配置 API Key。仍可导入 CurseForge ZIP 并安装基础游戏、加载器和覆盖文件；无法通过 API 获取的 Mod 会提供官方文件页，供你手动下载并导入。" />
                            <PasswordBox x:Name="CurseForgeApiKeyInput" Header="CurseForge API Key" PlaceholderText="粘贴已获批准的 API Key" MaxLength="2048" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="保存 API Key" Click="SaveCurseForgeApiKey_Click" Style="{ThemeResource AccentButtonStyle}" />
                                <Button Content="移除 API Key" Click="RemoveCurseForgeApiKey_Click" />
                                <Button Tag="curseforge-apply" Content="申请 API Key" Click="OpenGitHubLink_Click" />
                                <Button Tag="curseforge-terms" Content="API 使用条款" Click="OpenGitHubLink_Click" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <InfoBar IsOpen="True" IsClosable="False" Severity="Informational" Title="遵守 CurseForge 分发设置" Message="若作者未开放第三方分发，Sakana 会继续安装其余可用内容，并提供该 Mod 的官方文件页；你可以在浏览器下载后手动导入。Sakana 不会绕过作者设置。请勿共享个人 API Key。" />
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="AboutPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="16">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button Content="设置" Click="BackToSettings_Click" Padding="0" Background="Transparent" BorderThickness="0" Foreground="{ThemeResource SakanaMutedBrush}" />
                        <TextBlock Text="›" FontSize="22" Foreground="{ThemeResource SakanaMutedBrush}" />
                        <TextBlock Text="关于" FontSize="27" FontWeight="SemiBold" Foreground="{ThemeResource SakanaTextBrush}" />
                    </StackPanel>
                    <TextBlock Text="Sakana Launcher 的项目、版本与开源许可信息。" FontSize="13" Foreground="{ThemeResource SakanaMutedBrush}" />
                    <Border Padding="24" CornerRadius="12" Background="{ThemeResource SakanaSurfaceBrush}" BorderBrush="{ThemeResource SakanaStrokeBrush}" BorderThickness="1">
                        <StackPanel Spacing="16">
                            <StackPanel HorizontalAlignment="Center" Spacing="10">
                                <Border Width="72" Height="72" CornerRadius="18" Background="{ThemeResource SakanaAccentSoftBrush}" HorizontalAlignment="Center">
                                    <TextBlock Text="S" FontSize="48" FontWeight="Light" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource SakanaAccentBrush}" />
                                </Border>
                                <TextBlock Text="Sakana Launcher" FontSize="25" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{ThemeResource SakanaTextBrush}" />
                                <TextBlock x:Name="AppVersionText" Text="Sakana 0.1" FontSize="13" HorizontalAlignment="Center" Foreground="{ThemeResource SakanaMutedBrush}" />
                            </StackPanel>
                            <TextBlock Text="面向 Windows 11 的独立 Minecraft Java 启动器，专注于实例、整合包和内容管理。" FontSize="14" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center" Foreground="{ThemeResource SakanaMutedBrush}" />
                            <TextBlock Text="Sakana 是第三方项目，不是 Minecraft 官方产品，也未获 Mojang 或 Microsoft 认可或背书。" FontSize="12" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center" Foreground="{ThemeResource SakanaMutedBrush}" />
                            <Grid ColumnSpacing="10" RowSpacing="10" HorizontalAlignment="Center" MaxWidth="640">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Button Tag="repository" Click="OpenGitHubLink_Click" HorizontalAlignment="Stretch" Padding="14,12">
                                    <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                                        <SymbolIcon Symbol="Link" />
                                        <TextBlock Text="GitHub 仓库" />
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="1" Tag="releases" Click="OpenGitHubLink_Click" HorizontalAlignment="Stretch" Padding="14,12">
                                    <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                                        <SymbolIcon Symbol="Download" />
                                        <TextBlock Text="更新与版本" />
                                    </StackPanel>
                                </Button>
                                <Button Grid.Row="1" Tag="license" Click="OpenGitHubLink_Click" HorizontalAlignment="Stretch" Padding="14,12">
                                    <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                                        <SymbolIcon Symbol="OpenFile" />
                                        <TextBlock Text="开源许可证 · MIT" />
                                    </StackPanel>
                                </Button>
                                <Button Grid.Row="1" Grid.Column="1" Tag="issues" Click="OpenGitHubLink_Click" HorizontalAlignment="Stretch" Padding="14,12">
                                    <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                                        <SymbolIcon Symbol="Help" />
                                        <TextBlock Text="反馈与问题" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
      </Grid>
    </Border>
</Page>
