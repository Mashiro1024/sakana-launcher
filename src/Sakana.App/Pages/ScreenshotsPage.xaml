<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Sakana.App.Pages.ScreenshotsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Sakana.App.ViewModels">
    <Grid Padding="32,26,32,30" RowSpacing="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="4">
            <TextBlock Text="截图" FontSize="32" FontWeight="SemiBold" Foreground="{ThemeResource SakanaTextBrush}" />
            <TextBlock Text="按实例整理 Minecraft 截图；选择一张可查看大图。" FontSize="15" Foreground="{ThemeResource SakanaMutedBrush}" />
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ComboBox
                x:Name="InstancePicker"
                Header="实例"
                DisplayMemberPath="Name"
                PlaceholderText="选择一个实例"
                SelectionChanged="InstancePicker_SelectionChanged" />
            <Button Grid.Column="1" Content="打开截图文件夹" Click="OpenFolder_Click" VerticalAlignment="Bottom" />
            <Button Grid.Column="2" Content="刷新" Click="Refresh_Click" VerticalAlignment="Bottom" />
        </Grid>

        <Grid Grid.Row="2">
            <GridView
                x:Name="ScreenshotGrid"
                ItemsSource="{x:Bind Screenshots, Mode=OneWay}"
                IsItemClickEnabled="True"
                ItemClick="ScreenshotGrid_ItemClick"
                SelectionMode="None"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch">
                <GridView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsWrapGrid Orientation="Horizontal" ItemWidth="280" ItemHeight="244" />
                    </ItemsPanelTemplate>
                </GridView.ItemsPanel>
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="vm:ScreenshotItemViewModel">
                        <Border Width="264" Height="228" Padding="10" CornerRadius="12" Background="{ThemeResource SakanaSurfaceBrush}" BorderBrush="{ThemeResource SakanaStrokeBrush}" BorderThickness="1">
                            <Grid RowSpacing="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Border CornerRadius="8" Background="{ThemeResource SakanaAccentSoftBrush}">
                                    <Image Source="{x:Bind ImageSource}" Stretch="UniformToFill" />
                                </Border>
                                <TextBlock Grid.Row="1" Text="{x:Bind FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource SakanaTextBrush}" />
                                <TextBlock Grid.Row="2" Text="{x:Bind CapturedAtLabel}" FontSize="12" Foreground="{ThemeResource SakanaMutedBrush}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>

            <Border
                x:Name="EmptyState"
                Padding="28"
                CornerRadius="16"
                Background="{ThemeResource SakanaSurfaceBrush}"
                BorderBrush="{ThemeResource SakanaStrokeBrush}"
                BorderThickness="1"
                IsHitTestVisible="False">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" MaxWidth="460">
                    <Border Width="72" Height="72" CornerRadius="20" Background="{ThemeResource SakanaAccentSoftBrush}" HorizontalAlignment="Center">
                        <SymbolIcon Symbol="Pictures" Foreground="{ThemeResource SakanaAccentBrush}" />
                    </Border>
                    <TextBlock x:Name="EmptyTitle" Text="暂无截图" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{ThemeResource SakanaTextBrush}" />
                    <TextBlock x:Name="EmptyDescription" Text="在游戏中按 F2 截图，保存的图片会显示在这里。" FontSize="14" TextWrapping="Wrap" TextAlignment="Center" Foreground="{ThemeResource SakanaMutedBrush}" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
