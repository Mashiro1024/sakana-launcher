<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Sakana.App.Pages.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Sakana.App.ViewModels">
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="SplitButtonBackground" Color="#FF465BDC" />
                    <SolidColorBrush x:Key="SplitButtonBackgroundPointerOver" Color="#FF3B4FC7" />
                    <SolidColorBrush x:Key="SplitButtonBackgroundPressed" Color="#FF3144B2" />
                    <SolidColorBrush x:Key="SplitButtonForeground" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="SplitButtonForegroundPointerOver" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="SplitButtonForegroundPressed" Color="#E6FFFFFF" />
                    <SolidColorBrush x:Key="SplitButtonBorderBrush" Color="#FF465BDC" />
                    <SolidColorBrush x:Key="SplitButtonBorderBrushPointerOver" Color="#FF3B4FC7" />
                    <SolidColorBrush x:Key="SplitButtonBorderBrushPressed" Color="#FF3144B2" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="SplitButtonBackground" Color="#FF5468E8" />
                    <SolidColorBrush x:Key="SplitButtonBackgroundPointerOver" Color="#FF6679F2" />
                    <SolidColorBrush x:Key="SplitButtonBackgroundPressed" Color="#FF4559D4" />
                    <SolidColorBrush x:Key="SplitButtonForeground" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="SplitButtonForegroundPointerOver" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="SplitButtonForegroundPressed" Color="#E6FFFFFF" />
                    <SolidColorBrush x:Key="SplitButtonBorderBrush" Color="#FF5468E8" />
                    <SolidColorBrush x:Key="SplitButtonBorderBrushPointerOver" Color="#FF6679F2" />
                    <SolidColorBrush x:Key="SplitButtonBorderBrushPressed" Color="#FF4559D4" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="SplitButtonBackground" Color="#FF5468E8" />
                    <SolidColorBrush x:Key="SplitButtonBackgroundPointerOver" Color="#FF6679F2" />
                    <SolidColorBrush x:Key="SplitButtonBackgroundPressed" Color="#FF4559D4" />
                    <SolidColorBrush x:Key="SplitButtonForeground" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="SplitButtonForegroundPointerOver" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="SplitButtonForegroundPressed" Color="#E6FFFFFF" />
                    <SolidColorBrush x:Key="SplitButtonBorderBrush" Color="#FF5468E8" />
                    <SolidColorBrush x:Key="SplitButtonBorderBrushPointerOver" Color="#FF6679F2" />
                    <SolidColorBrush x:Key="SplitButtonBorderBrushPressed" Color="#FF4559D4" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <UniformGridLayout
                x:Key="GridInstancesLayout"
                Orientation="Horizontal"
                ItemsStretch="Fill"
                MinItemWidth="300"
                MinItemHeight="224"
                MinColumnSpacing="14"
                MinRowSpacing="14" />

        <StackLayout
            x:Key="ListInstancesLayout"
            Orientation="Vertical"
            Spacing="10" />

        <DataTemplate x:Key="GridInstanceTemplate" x:DataType="vm:InstanceCardViewModel">
            <Border
                Padding="16,14"
                CornerRadius="12"
                Background="{ThemeResource SakanaSurfaceBrush}"
                BorderBrush="{ThemeResource SakanaStrokeBrush}"
                BorderThickness="1"
                VerticalAlignment="Stretch">
                <Grid RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Card Header: Icon + Name + Version + Overflow -->
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Grid Width="48" Height="48" VerticalAlignment="Top">
                            <Border
                                Width="48"
                                Height="48"
                                CornerRadius="12"
                                Background="{ThemeResource SakanaAccentSoftBrush}"
                                BorderBrush="{ThemeResource SakanaStrokeBrush}"
                                BorderThickness="1">
                                <Grid>
                                    <!-- Vanilla grass-block glyph -->
                                    <Path
                                        Width="22"
                                        Height="22"
                                        Stretch="Uniform"
                                        Fill="{ThemeResource SakanaAccentBrush}"
                                        Visibility="{x:Bind VanillaDefaultGlyphVisibility, Mode=OneWay}"
                                        Data="M12,2 L21,7 L21,17 L12,22 L3,17 L3,7 Z M12,4.2 L5.4,8 L12,11.8 L18.6,8 Z M4.8,9.8 L4.8,15.9 L11.1,19.5 L11.1,13.4 Z M19.2,9.8 L12.9,13.4 L12.9,19.5 L19.2,15.9 Z" />
                                    <!-- Modded loader cube glyph -->
                                    <Path
                                        Width="22"
                                        Height="22"
                                        Stretch="Uniform"
                                        Fill="{ThemeResource SakanaAccentBrush}"
                                        Visibility="{x:Bind ModdedDefaultGlyphVisibility, Mode=OneWay}"
                                        Data="M12,2 L20,6.5 L20,17.5 L12,22 L4,17.5 L4,6.5 Z M12,4.4 L6.5,7.5 L12,10.6 L17.5,7.5 Z M11,12.2 L6,9.4 L6,16.2 L11,19 Z M13,12.2 L13,19 L18,16.2 L18,9.4 Z" />
                                    <Image
                                        Source="{x:Bind IconImage, Mode=OneWay}"
                                        Visibility="{x:Bind CustomIconVisibility, Mode=OneWay}"
                                        Stretch="UniformToFill" />
                                </Grid>
                            </Border>
                            <Border
                                MinWidth="18"
                                Height="18"
                                Padding="4,0"
                                CornerRadius="5"
                                Background="{ThemeResource SakanaSurfaceBrush}"
                                BorderBrush="{ThemeResource SakanaStrokeBrush}"
                                BorderThickness="1"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                Margin="0,0,-4,-4"
                                ToolTipService.ToolTip="{x:Bind LoaderDisplayName}">
                                <TextBlock
                                    Text="{x:Bind LoaderBadgeText}"
                                    FontSize="10"
                                    FontWeight="Bold"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource SakanaTextBrush}" />
                            </Border>
                        </Grid>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock
                                Text="{x:Bind Name, Mode=OneWay}"
                                FontSize="16"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource SakanaTextBrush}"
                                TextTrimming="CharacterEllipsis"
                                ToolTipService.ToolTip="{x:Bind Name, Mode=OneWay}" />
                            <TextBlock
                                Text="{x:Bind VersionLabel}"
                                FontSize="12"
                                Foreground="{ThemeResource SakanaMutedBrush}"
                                TextTrimming="CharacterEllipsis"
                                ToolTipService.ToolTip="{x:Bind VersionLabel}" />
                        </StackPanel>

                        <Button
                            Grid.Column="2"
                            Width="32"
                            Height="32"
                            Padding="0"
                            VerticalAlignment="Top"
                            Background="Transparent"
                            BorderThickness="0"
                            Tag="{x:Bind Id}"
                            Click="MoreActions_Click"
                            ToolTipService.ToolTip="更多操作"
                            AutomationProperties.Name="更多实例操作">
                            <FontIcon Glyph="&#xE712;" FontSize="14" Foreground="{ThemeResource SakanaMutedBrush}" />
                        </Button>
                    </Grid>

                    <!-- Card Body: Semantic Status + Metadata Chips + Progress / Error -->
                    <StackPanel Grid.Row="1" Spacing="8" VerticalAlignment="Top">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <!-- Ready Status Badge -->
                            <Border
                                Padding="8,3"
                                CornerRadius="99"
                                Background="{ThemeResource SakanaSuccessSoftBrush}"
                                Visibility="{x:Bind StateReadyVisibility, Mode=OneWay}"
                                ToolTipService.ToolTip="{x:Bind StateText, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <Ellipse Width="6" Height="6" Fill="{ThemeResource SakanaSuccessBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="{x:Bind StateBadgeText, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource SakanaSuccessBrush}" />
                                </StackPanel>
                            </Border>

                            <!-- Active / Running / Installing Status Badge -->
                            <Border
                                Padding="8,3"
                                CornerRadius="99"
                                Background="{ThemeResource SakanaAccentSoftBrush}"
                                Visibility="{x:Bind StateActiveVisibility, Mode=OneWay}"
                                ToolTipService.ToolTip="{x:Bind StateText, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <Ellipse Width="6" Height="6" Fill="{ThemeResource SakanaAccentBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="{x:Bind StateBadgeText, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource SakanaAccentBrush}" />
                                </StackPanel>
                            </Border>

                            <!-- Pending / Cancelled Status Badge -->
                            <Border
                                Padding="8,3"
                                CornerRadius="99"
                                Background="{ThemeResource SakanaWarningSoftBrush}"
                                Visibility="{x:Bind StateWarningVisibility, Mode=OneWay}"
                                ToolTipService.ToolTip="{x:Bind StateText, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <Ellipse Width="6" Height="6" Fill="{ThemeResource SakanaWarningBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="{x:Bind StateBadgeText, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource SakanaWarningBrush}" />
                                </StackPanel>
                            </Border>

                            <!-- Failed Status Badge -->
                            <Border
                                Padding="8,3"
                                CornerRadius="99"
                                Background="{ThemeResource SakanaErrorSoftBrush}"
                                Visibility="{x:Bind StateErrorVisibility, Mode=OneWay}"
                                ToolTipService.ToolTip="{x:Bind StateText, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <Ellipse Width="6" Height="6" Fill="{ThemeResource SakanaErrorBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="{x:Bind StateBadgeText, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource SakanaErrorBrush}" />
                                </StackPanel>
                            </Border>

                            <!-- Memory Chip -->
                            <Border Padding="8,3" CornerRadius="99" Background="{ThemeResource SakanaNeutralBadgeBrush}">
                                <TextBlock Text="{x:Bind CompactMemoryLabel, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource SakanaMutedBrush}" />
                            </Border>

                            <!-- Quick Play Chip -->
                            <Border
                                Padding="8,3"
                                CornerRadius="99"
                                Background="{ThemeResource SakanaNeutralBadgeBrush}"
                                Visibility="{x:Bind QuickPlayChipVisibility, Mode=OneWay}"
                                ToolTipService.ToolTip="{x:Bind QuickPlaySupportText, Mode=OneWay}">
                                <TextBlock Text="支持直达" FontSize="12" Foreground="{ThemeResource SakanaMutedBrush}" />
                            </Border>
                        </StackPanel>

                        <TextBlock
                            Text="{x:Bind OrganizationLabel, Mode=OneWay}"
                            Visibility="{x:Bind OrganizationVisibility, Mode=OneWay}"
                            FontSize="12"
                            Foreground="{ThemeResource SakanaMutedBrush}"
                            TextTrimming="CharacterEllipsis"
                            ToolTipService.ToolTip="{x:Bind OrganizationLabel, Mode=OneWay}" />

                        <StackPanel Spacing="4" Visibility="{x:Bind ProgressVisibility, Mode=OneWay}">
                            <ProgressBar Minimum="0" Maximum="100" Value="{x:Bind ProgressValue, Mode=OneWay}" />
                            <TextBlock
                                Text="{x:Bind ProgressStatus, Mode=OneWay}"
                                FontSize="12"
                                Foreground="{ThemeResource SakanaMutedBrush}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <TextBlock
                            Text="{x:Bind LastError, Mode=OneWay}"
                            Visibility="{x:Bind ErrorVisibility, Mode=OneWay}"
                            FontSize="12"
                            MaxLines="2"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="Wrap"
                            Foreground="{ThemeResource SakanaErrorBrush}"
                            ToolTipService.ToolTip="{x:Bind LastError, Mode=OneWay}" />
                    </StackPanel>

                    <!-- Card Footer: Quick Shortcuts + Primary Action -->
                    <Border
                        Grid.Row="2"
                        Padding="0,10,0,0"
                        BorderBrush="{ThemeResource SakanaStrokeBrush}"
                        BorderThickness="0,1,0,0">
                        <Grid>
                            <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center" HorizontalAlignment="Left">
                                <Button
                                    Width="32"
                                    Height="32"
                                    Padding="0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Tag="{x:Bind Id}"
                                    Click="LaunchSettings_Click"
                                    Visibility="{x:Bind LaunchSettingsVisibility, Mode=OneWay}"
                                    ToolTipService.ToolTip="启动与内存设置"
                                    AutomationProperties.Name="启动与内存设置">
                                    <FontIcon Glyph="&#xE713;" FontSize="14" Foreground="{ThemeResource SakanaMutedBrush}" />
                                </Button>
                                <Button
                                    Width="32"
                                    Height="32"
                                    Padding="0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Tag="{x:Bind Id}"
                                    Click="ManageMods_Click"
                                    Visibility="{x:Bind ManageModsActionVisibility, Mode=OneWay}"
                                    IsEnabled="{x:Bind ManageModsActionEnabled, Mode=OneWay}"
                                    ToolTipService.ToolTip="管理模组"
                                    AutomationProperties.Name="管理模组">
                                    <FontIcon Glyph="&#xEA86;" FontSize="14" Foreground="{ThemeResource SakanaMutedBrush}" />
                                </Button>
                                <Button
                                    Width="32"
                                    Height="32"
                                    Padding="0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Tag="{x:Bind Id}"
                                    Click="OpenInstanceFolder_Click"
                                    ToolTipService.ToolTip="打开实例文件夹"
                                    AutomationProperties.Name="打开实例文件夹">
                                    <FontIcon Glyph="&#xE8B7;" FontSize="14" Foreground="{ThemeResource SakanaMutedBrush}" />
                                </Button>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <SplitButton
                                    Style="{ThemeResource SakanaAccentSplitButtonStyle}"
                                    Tag="{x:Bind Id}"
                                    Click="LaunchSplitButton_Click"
                                    Visibility="{x:Bind LaunchActionVisibility, Mode=OneWay}"
                                    IsEnabled="{x:Bind LaunchActionEnabled, Mode=OneWay}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE768;" FontSize="12" />
                                        <TextBlock Text="启动" />
                                    </StackPanel>
                                    <SplitButton.Flyout>
                                        <MenuFlyout Placement="BottomEdgeAlignedRight" Opening="QuickLaunchFlyout_Opening" />
                                    </SplitButton.Flyout>
                                </SplitButton>

                                <Button
                                    Content="安装"
                                    Tag="{x:Bind Id}"
                                    Click="InstallProfile_Click"
                                    Visibility="{x:Bind InstallActionVisibility, Mode=OneWay}"
                                    Style="{ThemeResource AccentButtonStyle}" />

                                <Button
                                    Content="停止"
                                    Tag="{x:Bind Id}"
                                    Click="StopProfile_Click"
                                    Visibility="{x:Bind StopActionVisibility, Mode=OneWay}" />

                                <Button
                                    Content="取消"
                                    Tag="{x:Bind Id}"
                                    Click="CancelInstall_Click"
                                    Visibility="{x:Bind CancelActionVisibility, Mode=OneWay}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="ListInstanceTemplate" x:DataType="vm:InstanceCardViewModel">
            <Border
                Padding="16,12"
                CornerRadius="12"
                Background="{ThemeResource SakanaSurfaceBrush}"
                BorderBrush="{ThemeResource SakanaStrokeBrush}"
                BorderThickness="1">
                <StackPanel Spacing="10">
                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Grid Width="44" Height="44" VerticalAlignment="Center">
                            <Border
                                Width="44"
                                Height="44"
                                CornerRadius="10"
                                Background="{ThemeResource SakanaAccentSoftBrush}"
                                BorderBrush="{ThemeResource SakanaStrokeBrush}"
                                BorderThickness="1">
                                <Grid>
                                    <Path
                                        Width="20"
                                        Height="20"
                                        Stretch="Uniform"
                                        Fill="{ThemeResource SakanaAccentBrush}"
                                        Visibility="{x:Bind VanillaDefaultGlyphVisibility, Mode=OneWay}"
                                        Data="M12,2 L21,7 L21,17 L12,22 L3,17 L3,7 Z M12,4.2 L5.4,8 L12,11.8 L18.6,8 Z M4.8,9.8 L4.8,15.9 L11.1,19.5 L11.1,13.4 Z M19.2,9.8 L12.9,13.4 L12.9,19.5 L19.2,15.9 Z" />
                                    <Path
                                        Width="20"
                                        Height="20"
                                        Stretch="Uniform"
                                        Fill="{ThemeResource SakanaAccentBrush}"
                                        Visibility="{x:Bind ModdedDefaultGlyphVisibility, Mode=OneWay}"
                                        Data="M12,2 L20,6.5 L20,17.5 L12,22 L4,17.5 L4,6.5 Z M12,4.4 L6.5,7.5 L12,10.6 L17.5,7.5 Z M11,12.2 L6,9.4 L6,16.2 L11,19 Z M13,12.2 L13,19 L18,16.2 L18,9.4 Z" />
                                    <Image
                                        Source="{x:Bind IconImage, Mode=OneWay}"
                                        Visibility="{x:Bind CustomIconVisibility, Mode=OneWay}"
                                        Stretch="UniformToFill" />
                                </Grid>
                            </Border>
                            <Border
                                MinWidth="17"
                                Height="17"
                                Padding="4,0"
                                CornerRadius="5"
                                Background="{ThemeResource SakanaSurfaceBrush}"
                                BorderBrush="{ThemeResource SakanaStrokeBrush}"
                                BorderThickness="1"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                Margin="0,0,-4,-4">
                                <TextBlock
                                    Text="{x:Bind LoaderBadgeText}"
                                    FontSize="10"
                                    FontWeight="Bold"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource SakanaTextBrush}" />
                            </Border>
                        </Grid>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock
                                    Text="{x:Bind Name, Mode=OneWay}"
                                    FontSize="15"
                                    FontWeight="SemiBold"
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource SakanaTextBrush}"
                                    TextTrimming="CharacterEllipsis" />
                                <Border Padding="8,2" CornerRadius="99" Background="{ThemeResource SakanaSuccessSoftBrush}" Visibility="{x:Bind StateReadyVisibility, Mode=OneWay}">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <Ellipse Width="6" Height="6" Fill="{ThemeResource SakanaSuccessBrush}" VerticalAlignment="Center" />
                                        <TextBlock Text="{x:Bind StateBadgeText, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource SakanaSuccessBrush}" />
                                    </StackPanel>
                                </Border>
                                <Border Padding="8,2" CornerRadius="99" Background="{ThemeResource SakanaAccentSoftBrush}" Visibility="{x:Bind StateActiveVisibility, Mode=OneWay}">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <Ellipse Width="6" Height="6" Fill="{ThemeResource SakanaAccentBrush}" VerticalAlignment="Center" />
                                        <TextBlock Text="{x:Bind StateBadgeText, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource SakanaAccentBrush}" />
                                    </StackPanel>
                                </Border>
                                <Border Padding="8,2" CornerRadius="99" Background="{ThemeResource SakanaWarningSoftBrush}" Visibility="{x:Bind StateWarningVisibility, Mode=OneWay}">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <Ellipse Width="6" Height="6" Fill="{ThemeResource SakanaWarningBrush}" VerticalAlignment="Center" />
                                        <TextBlock Text="{x:Bind StateBadgeText, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource SakanaWarningBrush}" />
                                    </StackPanel>
                                </Border>
                                <Border Padding="8,2" CornerRadius="99" Background="{ThemeResource SakanaErrorSoftBrush}" Visibility="{x:Bind StateErrorVisibility, Mode=OneWay}">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <Ellipse Width="6" Height="6" Fill="{ThemeResource SakanaErrorBrush}" VerticalAlignment="Center" />
                                        <TextBlock Text="{x:Bind StateBadgeText, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource SakanaErrorBrush}" />
                                    </StackPanel>
                                </Border>
                                <Border Padding="8,2" CornerRadius="99" Background="{ThemeResource SakanaNeutralBadgeBrush}" Visibility="{x:Bind QuickPlayChipVisibility, Mode=OneWay}">
                                    <TextBlock Text="支持直达" FontSize="12" Foreground="{ThemeResource SakanaMutedBrush}" />
                                </Border>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{x:Bind VersionLabel}" FontSize="12" Foreground="{ThemeResource SakanaMutedBrush}" />
                                <TextBlock Text="·" FontSize="12" Foreground="{ThemeResource SakanaMutedBrush}" />
                                <TextBlock Text="{x:Bind MemoryLabel, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource SakanaMutedBrush}" />
                                <TextBlock Text="·" FontSize="12" Foreground="{ThemeResource SakanaMutedBrush}" Visibility="{x:Bind OrganizationVisibility, Mode=OneWay}" />
                                <TextBlock Text="{x:Bind OrganizationLabel, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource SakanaMutedBrush}" Visibility="{x:Bind OrganizationVisibility, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
                            <SplitButton
                                Style="{ThemeResource SakanaAccentSplitButtonStyle}"
                                Tag="{x:Bind Id}"
                                Click="LaunchSplitButton_Click"
                                Visibility="{x:Bind LaunchActionVisibility, Mode=OneWay}"
                                IsEnabled="{x:Bind LaunchActionEnabled, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE768;" FontSize="12" />
                                    <TextBlock Text="启动" />
                                </StackPanel>
                                <SplitButton.Flyout>
                                    <MenuFlyout Placement="BottomEdgeAlignedRight" Opening="QuickLaunchFlyout_Opening" />
                                </SplitButton.Flyout>
                            </SplitButton>
                            <Button Content="安装" Tag="{x:Bind Id}" Click="InstallProfile_Click" Visibility="{x:Bind InstallActionVisibility, Mode=OneWay}" Style="{ThemeResource AccentButtonStyle}" />
                            <Button Content="停止" Tag="{x:Bind Id}" Click="StopProfile_Click" Visibility="{x:Bind StopActionVisibility, Mode=OneWay}" />
                            <Button Content="取消" Tag="{x:Bind Id}" Click="CancelInstall_Click" Visibility="{x:Bind CancelActionVisibility, Mode=OneWay}" />
                            <Button
                                Width="34"
                                Height="32"
                                Padding="0"
                                Tag="{x:Bind Id}"
                                Click="MoreActions_Click"
                                ToolTipService.ToolTip="更多操作"
                                AutomationProperties.Name="更多实例操作">
                                <FontIcon Glyph="&#xE712;" FontSize="14" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <StackPanel Spacing="4" Visibility="{x:Bind ProgressVisibility, Mode=OneWay}">
                        <ProgressBar Minimum="0" Maximum="100" Value="{x:Bind ProgressValue, Mode=OneWay}" />
                        <TextBlock Text="{x:Bind ProgressStatus, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource SakanaMutedBrush}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <TextBlock
                        Text="{x:Bind LastError, Mode=OneWay}"
                        Visibility="{x:Bind ErrorVisibility, Mode=OneWay}"
                        FontSize="12"
                        TextWrapping="Wrap"
                        Foreground="{ThemeResource SakanaErrorBrush}" />
                </StackPanel>
            </Border>
        </DataTemplate>
        </ResourceDictionary>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Padding="28,24,28,32">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup>
                    <VisualState x:Name="WideState">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="920" />
                        </VisualState.StateTriggers>
                    </VisualState>
                    <VisualState x:Name="NarrowState">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="0" />
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="HeaderActionsPanel.(Grid.Row)" Value="1" />
                            <Setter Target="HeaderActionsPanel.(Grid.Column)" Value="0" />
                            <Setter Target="HeaderActionsPanel.HorizontalAlignment" Value="Left" />
                            <Setter Target="HeaderActionsPanel.Margin" Value="0,12,0,0" />
                            <Setter Target="ToolbarRightPanel.(Grid.Row)" Value="1" />
                            <Setter Target="ToolbarRightPanel.(Grid.Column)" Value="0" />
                            <Setter Target="ToolbarRightPanel.HorizontalAlignment" Value="Left" />
                            <Setter Target="ToolbarRightPanel.Margin" Value="0,8,0,0" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>

            <StackPanel MaxWidth="1360" HorizontalAlignment="Stretch" Spacing="18">
                <!-- Header -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Spacing="4">
                        <TextBlock Text="你的游戏空间" FontSize="28" FontWeight="SemiBold" Foreground="{ThemeResource SakanaTextBrush}" />
                        <TextBlock Text="每个实例都有独立的版本、模组目录和运行时配置。" FontSize="14" Foreground="{ThemeResource SakanaMutedBrush}" />
                    </StackPanel>

                    <StackPanel
                        x:Name="HeaderActionsPanel"
                        Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="8"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center">
                        <Button Content="在线浏览整合包" Click="BrowseModrinthPacks_Click" Padding="13,8" />
                        <Button Content="导入整合包" Click="ImportModpack_Click" Padding="13,8" />
                        <Button Content="＋  新建实例" Click="CreateProfile_Click" Padding="15,8" Style="{ThemeResource AccentButtonStyle}" FontWeight="SemiBold" />
                    </StackPanel>
                </Grid>

                <!-- InfoBars -->
                <InfoBar
                    x:Name="PreviewInfoBar"
                    IsOpen="True"
                    IsClosable="True"
                    CloseButtonClick="PreviewInfoBar_CloseButtonClick"
                    Severity="Informational"
                    Title="实例安装器"
                    Message="可创建原版、Fabric、Quilt、Forge 或 NeoForge 实例，也可导入 Modrinth .mrpack / CurseForge 整合包；安装时会校验游戏文件并准备匹配的 Java 运行时。" />
                <InfoBar x:Name="RepairInfoBar" IsOpen="False" Severity="Success" IsClosable="True" />
                <InfoBar x:Name="ErrorInfoBar" IsOpen="False" Severity="Error" Title="操作失败" />

                <!-- Streamlined Single-Row Toolbar -->
                <Grid x:Name="OrganizationToolbar" ColumnSpacing="12" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <AutoSuggestBox
                            x:Name="LibrarySearchBox"
                            Width="240"
                            QueryIcon="Find"
                            PlaceholderText="搜索名称、版本、分组或标签"
                            TextChanged="LibrarySearch_TextChanged" />

                        <ComboBox
                            x:Name="LoaderFilterComboBox"
                            Width="136"
                            SelectedIndex="0"
                            SelectionChanged="LibraryFilter_SelectionChanged"
                            ToolTipService.ToolTip="按加载器筛选">
                            <ComboBoxItem Content="全部加载器" Tag="" />
                            <ComboBoxItem Content="原版（Vanilla）" Tag="vanilla" />
                            <ComboBoxItem Content="Fabric" Tag="fabric" />
                            <ComboBoxItem Content="Quilt" Tag="quilt" />
                            <ComboBoxItem Content="Forge" Tag="forge" />
                            <ComboBoxItem Content="NeoForge" Tag="neoforge" />
                        </ComboBox>
                    </StackPanel>

                    <StackPanel
                        x:Name="ToolbarRightPanel"
                        Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="8"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center">
                        <TextBlock
                            x:Name="LibraryCountText"
                            FontSize="12"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource SakanaMutedBrush}" />

                        <Button
                            x:Name="ClearFiltersButton"
                            Content="清除筛选"
                            Visibility="Collapsed"
                            Click="ClearLibraryFilters_Click" />

                        <Button x:Name="FilterFlyoutButton" ToolTipService.ToolTip="分组、状态、标签、排序与已保存视图">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE71C;" FontSize="13" />
                                <TextBlock Text="筛选与排序" />
                                <InfoBadge x:Name="ActiveFilterBadge" Visibility="Collapsed" />
                            </StackPanel>
                            <Button.Flyout>
                                <Flyout Placement="BottomEdgeAlignedRight">
                                    <StackPanel Width="290" Spacing="12">
                                        <Grid>
                                            <TextBlock Text="筛选与排序" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{ThemeResource SakanaTextBrush}" />
                                            <HyperlinkButton Content="重置全部" Click="ClearLibraryFilters_Click" HorizontalAlignment="Right" Padding="4,2" />
                                        </Grid>

                                        <ComboBox x:Name="GroupFilterComboBox" Header="分组" HorizontalAlignment="Stretch" SelectionChanged="LibraryFilter_SelectionChanged" />

                                        <ComboBox x:Name="StateFilterComboBox" Header="状态" HorizontalAlignment="Stretch" SelectedIndex="0" SelectionChanged="LibraryFilter_SelectionChanged">
                                            <ComboBoxItem Content="全部状态" Tag="" />
                                            <ComboBoxItem Content="已安装" Tag="installed" />
                                            <ComboBoxItem Content="需要安装" Tag="uninstalled" />
                                            <ComboBoxItem Content="安装中" Tag="installing" />
                                            <ComboBoxItem Content="安装失败" Tag="failed" />
                                            <ComboBoxItem Content="运行中" Tag="running" />
                                        </ComboBox>

                                        <ComboBox x:Name="TagFilterComboBox" Header="标签" HorizontalAlignment="Stretch" SelectionChanged="LibraryFilter_SelectionChanged" />

                                        <ComboBox x:Name="SortFilterComboBox" Header="排序方式" HorizontalAlignment="Stretch" SelectedIndex="0" SelectionChanged="LibraryFilter_SelectionChanged">
                                            <ComboBoxItem Content="创建时间（新到旧）" Tag="created-desc" />
                                            <ComboBoxItem Content="名称 A–Z" Tag="name-asc" />
                                            <ComboBoxItem Content="名称 Z–A" Tag="name-desc" />
                                            <ComboBoxItem Content="Minecraft 版本" Tag="version-desc" />
                                        </ComboBox>

                                        <Border Height="1" Background="{ThemeResource SakanaStrokeBrush}" Margin="0,2" />

                                        <ComboBox x:Name="SavedLibraryViewComboBox" Header="已保存的视图" HorizontalAlignment="Stretch" SelectionChanged="SavedLibraryView_SelectionChanged" />

                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Button Content="保存当前视图…" Click="SaveCurrentLibraryView_Click" HorizontalAlignment="Stretch" />
                                            <Button Grid.Column="1" Content="删除" Click="DeleteSavedLibraryView_Click" />
                                        </Grid>
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>

                        <!-- Grid / List View Switcher -->
                        <StackPanel Orientation="Horizontal" Spacing="2">
                            <ToggleButton
                                x:Name="GridViewButton"
                                Width="34"
                                Height="32"
                                Padding="0"
                                IsChecked="True"
                                Click="GridViewButton_Click"
                                ToolTipService.ToolTip="卡片网格视图"
                                AutomationProperties.Name="卡片网格视图">
                                <FontIcon Glyph="&#xF0E2;" FontSize="13" />
                            </ToggleButton>
                            <ToggleButton
                                x:Name="ListViewButton"
                                Width="34"
                                Height="32"
                                Padding="0"
                                IsChecked="False"
                                Click="ListViewButton_Click"
                                ToolTipService.ToolTip="紧凑列表视图"
                                AutomationProperties.Name="紧凑列表视图">
                                <FontIcon Glyph="&#xE8FD;" FontSize="13" />
                            </ToggleButton>
                        </StackPanel>

                        <Button
                            x:Name="ShowGuideButton"
                            Width="34"
                            Height="32"
                            Padding="0"
                            Visibility="Collapsed"
                            Click="ShowGuideButton_Click"
                            ToolTipService.ToolTip="显示实例安装器说明"
                            AutomationProperties.Name="显示实例安装器说明">
                            <FontIcon Glyph="&#xE946;" FontSize="13" Foreground="{ThemeResource SakanaMutedBrush}" />
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Empty State -->
                <Border
                    x:Name="EmptyState"
                    Padding="36"
                    CornerRadius="16"
                    Background="{ThemeResource SakanaSurfaceBrush}"
                    BorderBrush="{ThemeResource SakanaStrokeBrush}"
                    BorderThickness="1">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" MaxWidth="460">
                        <Border Width="64" Height="64" CornerRadius="18" Background="{ThemeResource SakanaAccentSoftBrush}" HorizontalAlignment="Center">
                            <SymbolIcon Symbol="Library" Foreground="{ThemeResource SakanaAccentBrush}" />
                        </Border>
                        <TextBlock Text="实例库还是空的" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{ThemeResource SakanaTextBrush}" />
                        <TextBlock Text="创建一个实例，选择 Minecraft 版本，然后安装游戏文件；也可以直接浏览或导入整合包。" FontSize="13" TextWrapping="Wrap" TextAlignment="Center" Foreground="{ThemeResource SakanaMutedBrush}" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8" Margin="0,4,0,0">
                            <Button Content="创建第一个实例" Click="CreateProfile_Click" Padding="16,9" Style="{ThemeResource AccentButtonStyle}" FontWeight="SemiBold" />
                            <Button Content="导入整合包" Click="ImportModpack_Click" Padding="16,9" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- No Search/Filter Results -->
                <Border
                    x:Name="NoResultsState"
                    Padding="28"
                    CornerRadius="14"
                    Background="{ThemeResource SakanaSurfaceBrush}"
                    BorderBrush="{ThemeResource SakanaStrokeBrush}"
                    BorderThickness="1"
                    Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Center" Spacing="8">
                        <TextBlock Text="没有匹配的实例" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{ThemeResource SakanaTextBrush}" />
                        <TextBlock Text="调整搜索内容或筛选条件，再试一次。" FontSize="13" HorizontalAlignment="Center" Foreground="{ThemeResource SakanaMutedBrush}" />
                        <Button Content="清除全部筛选" Click="ClearLibraryFilters_Click" HorizontalAlignment="Center" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <!-- Responsive Instances Repeater -->
                <ItemsRepeater
                    x:Name="ProfileItems"
                    ItemsSource="{x:Bind ViewModel.VisibleProfiles, Mode=OneWay}"
                    Layout="{StaticResource GridInstancesLayout}"
                    ItemTemplate="{StaticResource GridInstanceTemplate}"
                    Visibility="Collapsed" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
