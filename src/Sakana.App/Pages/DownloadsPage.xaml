<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Sakana.App.Pages.DownloadsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Sakana.App.ViewModels">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="32,26,32,32" Spacing="22">
            <StackPanel Spacing="4">
                <TextBlock Text="下载中心" FontSize="32" FontWeight="SemiBold" Foreground="{ThemeResource SakanaTextBrush}" />
                <TextBlock Text="查看游戏文件与 Java 运行时的安装进度、完成状态和失败原因。" FontSize="15" Foreground="{ThemeResource SakanaMutedBrush}" />
            </StackPanel>

            <InfoBar x:Name="LoadErrorInfoBar" IsOpen="False" Severity="Error" Title="无法读取下载状态" Message="请检查本地数据目录，并查看 Sakana 日志。" />

            <Border x:Name="EmptyState" Padding="28" CornerRadius="16" Background="{ThemeResource SakanaSurfaceBrush}" BorderBrush="{ThemeResource SakanaStrokeBrush}" BorderThickness="1">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" MaxWidth="440">
                    <Border Width="64" Height="64" CornerRadius="18" Background="{ThemeResource SakanaAccentSoftBrush}" HorizontalAlignment="Center">
                        <SymbolIcon Symbol="Download" Foreground="{ThemeResource SakanaAccentBrush}" />
                    </Border>
                    <TextBlock Text="目前没有安装任务" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{ThemeResource SakanaTextBrush}" />
                    <TextBlock Text="从实例库开始安装后，进度、校验结果和失败重试会显示在这里。" FontSize="14" TextWrapping="Wrap" TextAlignment="Center" Foreground="{ThemeResource SakanaMutedBrush}" />
                </StackPanel>
            </Border>

            <ItemsControl x:Name="JobsList" ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}" Visibility="Collapsed">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="12" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:InstanceCardViewModel">
                        <Border Padding="18" CornerRadius="14" Background="{ThemeResource SakanaSurfaceBrush}" BorderBrush="{ThemeResource SakanaStrokeBrush}" BorderThickness="1">
                            <StackPanel Spacing="12">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="48" Height="48" CornerRadius="13" Background="{ThemeResource SakanaAccentSoftBrush}">
                                        <SymbolIcon Symbol="Download" Foreground="{ThemeResource SakanaAccentBrush}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                        <TextBlock Text="{x:Bind Name}" FontSize="16" FontWeight="SemiBold" Foreground="{ThemeResource SakanaTextBrush}" />
                                        <TextBlock Text="{x:Bind VersionLabel}" FontSize="13" Foreground="{ThemeResource SakanaMutedBrush}" />
                                        <TextBlock Text="{x:Bind StateText, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource SakanaAccentBrush}" />
                                        <TextBlock Text="{x:Bind LastError, Mode=OneWay}" Visibility="{x:Bind ErrorVisibility, Mode=OneWay}" FontSize="12" TextWrapping="Wrap" Foreground="#FFFF8C8C" />
                                    </StackPanel>
                                    <Button Grid.Column="2" Content="取消" Tag="{x:Bind Id}" Click="CancelInstall_Click" Visibility="{x:Bind CancelActionVisibility, Mode=OneWay}" VerticalAlignment="Center" />
                                </Grid>
                                <ProgressBar Minimum="0" Maximum="100" Value="{x:Bind ProgressValue, Mode=OneWay}" Visibility="{x:Bind ProgressVisibility, Mode=OneWay}" />
                                <TextBlock Text="{x:Bind ProgressStatus, Mode=OneWay}" Visibility="{x:Bind ProgressVisibility, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource SakanaMutedBrush}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</Page>
