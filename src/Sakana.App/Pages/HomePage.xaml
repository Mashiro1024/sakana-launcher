<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Sakana.App.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewModels="using:Sakana.App.ViewModels">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Padding="28,24,28,32">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup>
                    <VisualState x:Name="WideState">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="920" />
                        </VisualState.StateTriggers>
                    </VisualState>
                    <VisualState x:Name="NarrowState">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="0" />
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="HeroEmblemGrid.Visibility" Value="Collapsed" />
                            <Setter Target="StatusCardBorder.(Grid.Row)" Value="1" />
                            <Setter Target="StatusCardBorder.(Grid.Column)" Value="0" />
                            <Setter Target="StatusCardBorder.(Grid.ColumnSpan)" Value="2" />
                            <Setter Target="OverviewCardBorder.(Grid.ColumnSpan)" Value="2" />
                            <Setter Target="ActiveProcessCardBorder.(Grid.Row)" Value="1" />
                            <Setter Target="ActiveProcessCardBorder.(Grid.Column)" Value="0" />
                            <Setter Target="ActiveProcessCardBorder.(Grid.ColumnSpan)" Value="2" />
                            <Setter Target="HistoryCardBorder.(Grid.ColumnSpan)" Value="2" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>

            <StackPanel MaxWidth="1360" HorizontalAlignment="Stretch" Spacing="20">
                <StackPanel Spacing="4">
                    <TextBlock Text="SAKANA  /  MINECRAFT JAVA" FontSize="12" FontWeight="SemiBold" CharacterSpacing="120" Foreground="{ThemeResource SakanaAccentBrush}" />
                    <TextBlock Text="欢迎回来" FontSize="28" FontWeight="SemiBold" Foreground="{ThemeResource SakanaTextBrush}" />
                    <TextBlock Text="把你的 Minecraft 世界整理在一个清晰、安静的空间里。" FontSize="14" Foreground="{ThemeResource SakanaMutedBrush}" />
                </StackPanel>

                <Border CornerRadius="16" Padding="26" Background="{ThemeResource SakanaSurfaceBrush}" BorderBrush="{ThemeResource SakanaStrokeBrush}" BorderThickness="1">
                    <Grid ColumnSpacing="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Spacing="12" VerticalAlignment="Center">
                            <Border Background="{ThemeResource SakanaAccentSoftBrush}" CornerRadius="8" Padding="10,4" HorizontalAlignment="Left">
                                <TextBlock Text="VANILLA · FABRIC · QUILT · FORGE · NEOFORGE" FontSize="11" FontWeight="SemiBold" CharacterSpacing="80" Foreground="{ThemeResource SakanaAccentBrush}" />
                            </Border>
                            <TextBlock Text="你的下一段冒险，&#10;从这里开始。" FontSize="30" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{ThemeResource SakanaTextBrush}" />
                            <TextBlock Text="创建独立实例，自由选择原版或主流模组加载器，自动准备匹配的游戏文件与 Java 运行时。" FontSize="14" TextWrapping="Wrap" Foreground="{ThemeResource SakanaMutedBrush}" MaxWidth="560" />
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2,0,0">
                                <Button Content="打开实例库" Click="OpenLibrary_Click" Padding="16,9" Style="{ThemeResource AccentButtonStyle}" FontWeight="SemiBold" />
                                <Button Content="浏览或创建配置" Click="CreateProfile_Click" Padding="16,9" />
                            </StackPanel>
                        </StackPanel>

                        <Grid x:Name="HeroEmblemGrid" Grid.Column="1" Width="220" MinHeight="190">
                            <Ellipse Width="210" Height="210" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="{ThemeResource SakanaAccentSoftBrush}" Opacity="0.9" />
                            <Ellipse Width="148" Height="148" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="{ThemeResource SakanaAccentBrush}" Opacity="0.2" />
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                                <Image Source="ms-appx:///Assets/Square150x150Logo.scale-200.png" Width="76" Height="76" HorizontalAlignment="Center" />
                                <TextBlock Text="S A K A N A" FontSize="11" FontWeight="SemiBold" CharacterSpacing="240" HorizontalAlignment="Center" Foreground="{ThemeResource SakanaTextBrush}" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <InfoBar x:Name="LoadErrorInfoBar" IsOpen="False" Severity="Error" Title="首页数据加载失败" Message="无法读取实例配置或启动记录。请检查本地数据目录，并查看 Sakana 日志。" />

                <Grid ColumnSpacing="16" RowSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border x:Name="OverviewCardBorder" Padding="20" CornerRadius="14" Background="{ThemeResource SakanaSurfaceBrush}" BorderBrush="{ThemeResource SakanaStrokeBrush}" BorderThickness="1">
                        <StackPanel Spacing="14">
                            <Grid>
                                <StackPanel Spacing="2">
                                    <TextBlock Text="实例概览" FontSize="18" FontWeight="SemiBold" Foreground="{ThemeResource SakanaTextBrush}" />
                                    <TextBlock Text="{x:Bind ViewModel.ProfileCountText, Mode=OneWay}" FontSize="13" Foreground="{ThemeResource SakanaMutedBrush}" />
                                </StackPanel>
                                <Button Content="管理实例" Click="OpenLibrary_Click" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                            <Border x:Name="EmptyProfilesState" Padding="16" CornerRadius="10" Background="{ThemeResource SakanaSurfaceRaisedBrush}">
                                <TextBlock Text="还没有实例配置。前往实例库创建一个配置，开始整理你的游戏版本。" TextWrapping="Wrap" Foreground="{ThemeResource SakanaMutedBrush}" />
                            </Border>
                            <ItemsControl x:Name="ProfileItems" ItemsSource="{x:Bind ViewModel.ProfileSummaries, Mode=OneWay}" Visibility="Collapsed">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Spacing="8" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="viewModels:HomeInstanceSummary">
                                        <Border Padding="12" CornerRadius="10" Background="{ThemeResource SakanaSurfaceRaisedBrush}">
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border Width="40" Height="40" CornerRadius="10" Background="{ThemeResource SakanaAccentSoftBrush}">
                                                    <Path
                                                        Width="18"
                                                        Height="18"
                                                        Stretch="Uniform"
                                                        Fill="{ThemeResource SakanaAccentBrush}"
                                                        Data="M12,2 L21,7 L21,17 L12,22 L3,17 L3,7 Z M12,4.2 L5.4,8 L12,11.8 L18.6,8 Z M4.8,9.8 L4.8,15.9 L11.1,19.5 L11.1,13.4 Z M19.2,9.8 L12.9,13.4 L12.9,19.5 L19.2,15.9 Z" />
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                    <TextBlock Text="{x:Bind Name}" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource SakanaTextBrush}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{x:Bind VersionLabel}" FontSize="12" Foreground="{ThemeResource SakanaMutedBrush}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <Border Grid.Column="2" Padding="8,3" CornerRadius="99" Background="{ThemeResource SakanaSuccessSoftBrush}" VerticalAlignment="Center" Visibility="{x:Bind ReadyVisibility}">
                                                    <TextBlock Text="{x:Bind StateLabel}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource SakanaSuccessBrush}" />
                                                </Border>
                                                <Border Grid.Column="2" Padding="8,3" CornerRadius="99" Background="{ThemeResource SakanaNeutralBadgeBrush}" VerticalAlignment="Center" Visibility="{x:Bind PendingVisibility}">
                                                    <TextBlock Text="{x:Bind StateLabel}" FontSize="12" Foreground="{ThemeResource SakanaMutedBrush}" />
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border x:Name="StatusCardBorder" Grid.Column="1" Padding="20" CornerRadius="14" Background="{ThemeResource SakanaSurfaceBrush}" BorderBrush="{ThemeResource SakanaStrokeBrush}" BorderThickness="1">
                        <StackPanel Spacing="12">
                            <TextBlock Text="工作区状态" FontSize="18" FontWeight="SemiBold" Foreground="{ThemeResource SakanaTextBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.ReadySummaryText, Mode=OneWay}" FontSize="13" TextWrapping="Wrap" Foreground="{ThemeResource SakanaMutedBrush}" />
                            <Border Height="1" Background="{ThemeResource SakanaStrokeBrush}" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Ellipse Width="8" Height="8" Fill="{ThemeResource SakanaSuccessBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="本地实例存储已就绪" FontSize="13" Foreground="{ThemeResource SakanaTextBrush}" />
                            </StackPanel>
                            <TextBlock Text="设置、实例目录与账户凭据均安全保存在本地设备上。" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource SakanaMutedBrush}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid ColumnSpacing="16" RowSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border x:Name="HistoryCardBorder" Padding="20" CornerRadius="14" Background="{ThemeResource SakanaSurfaceBrush}" BorderBrush="{ThemeResource SakanaStrokeBrush}" BorderThickness="1">
                        <StackPanel Spacing="14">
                            <Grid>
                                <StackPanel Spacing="2">
                                    <TextBlock Text="最近启动" FontSize="18" FontWeight="SemiBold" Foreground="{ThemeResource SakanaTextBrush}" />
                                    <TextBlock Text="最近 12 次游戏运行记录" FontSize="13" Foreground="{ThemeResource SakanaMutedBrush}" />
                                </StackPanel>
                                <Button Content="查看实例库" Click="OpenLibrary_Click" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                            <Border x:Name="HistoryEmptyState" Padding="16" CornerRadius="10" Background="{ThemeResource SakanaSurfaceRaisedBrush}">
                                <TextBlock Text="还没有启动记录。连接 Microsoft 账户并启动 Minecraft 后，最近运行情况会显示在这里。" TextWrapping="Wrap" Foreground="{ThemeResource SakanaMutedBrush}" />
                            </Border>
                            <ItemsControl x:Name="HistoryItems" ItemsSource="{x:Bind ViewModel.RecentLaunches, Mode=OneWay}" Visibility="Collapsed">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Spacing="8" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="viewModels:LaunchHistoryCardViewModel">
                                        <Border Padding="12" CornerRadius="10" Background="{ThemeResource SakanaSurfaceRaisedBrush}">
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Width="38" Height="38" CornerRadius="10" Background="{ThemeResource SakanaAccentSoftBrush}">
                                                    <SymbolIcon Symbol="Play" Foreground="{ThemeResource SakanaAccentBrush}" />
                                                </Border>
                                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                    <Grid ColumnSpacing="8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{x:Bind InstanceName}" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource SakanaTextBrush}" />
                                                        <TextBlock Grid.Column="1" Text="{x:Bind StatusText}" FontSize="12" Foreground="{ThemeResource SakanaAccentBrush}" />
                                                    </Grid>
                                                    <TextBlock Text="{x:Bind VersionText}" FontSize="12" Foreground="{ThemeResource SakanaMutedBrush}" />
                                                    <TextBlock Text="{x:Bind StartedAtText}" FontSize="11" Foreground="{ThemeResource SakanaMutedBrush}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border x:Name="ActiveProcessCardBorder" Grid.Column="1" Padding="20" CornerRadius="14" Background="{ThemeResource SakanaSurfaceBrush}" BorderBrush="{ThemeResource SakanaStrokeBrush}" BorderThickness="1">
                        <StackPanel Spacing="14">
                            <StackPanel Spacing="2">
                                <TextBlock Text="运行中的游戏" FontSize="18" FontWeight="SemiBold" Foreground="{ThemeResource SakanaTextBrush}" />
                                <TextBlock Text="实时进程状态" FontSize="13" Foreground="{ThemeResource SakanaMutedBrush}" />
                            </StackPanel>
                            <Border x:Name="ActiveProcessEmptyState" Padding="16" CornerRadius="10" Background="{ThemeResource SakanaSurfaceRaisedBrush}">
                                <TextBlock Text="当前没有运行中的 Minecraft 进程。" TextWrapping="Wrap" Foreground="{ThemeResource SakanaMutedBrush}" />
                            </Border>
                            <ItemsControl x:Name="ActiveProcessItems" ItemsSource="{x:Bind ViewModel.ActiveProcesses, Mode=OneWay}" Visibility="Collapsed">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Spacing="8" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="viewModels:ActiveGameProcessViewModel">
                                        <Border Padding="14" CornerRadius="10" Background="{ThemeResource SakanaSurfaceRaisedBrush}">
                                            <StackPanel Spacing="6">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <Ellipse Width="8" Height="8" Fill="{ThemeResource SakanaSuccessBrush}" VerticalAlignment="Center" />
                                                    <TextBlock Text="正在运行" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource SakanaSuccessBrush}" />
                                                </StackPanel>
                                                <TextBlock Text="{x:Bind VersionText}" FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource SakanaTextBrush}" />
                                                <TextBlock Text="{x:Bind ProcessIdText}" FontSize="12" Foreground="{ThemeResource SakanaMutedBrush}" />
                                                <TextBlock Text="{x:Bind StartedAtText}" FontSize="12" Foreground="{ThemeResource SakanaMutedBrush}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
