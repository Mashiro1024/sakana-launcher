<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Sakana.App.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:domain="using:Sakana.Domain"
    xmlns:viewModels="using:Sakana.App.ViewModels">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="32,26,32,32" Spacing="24">
            <StackPanel Spacing="4">
                <TextBlock Text="SAKANA  /  MINECRAFT JAVA" FontSize="12" FontWeight="SemiBold" CharacterSpacing="120" Foreground="{ThemeResource SakanaAccentBrush}" />
                <TextBlock Text="欢迎回来" FontSize="32" FontWeight="SemiBold" Foreground="{ThemeResource SakanaTextBrush}" />
                <TextBlock Text="把你的 Minecraft 世界整理在一个清晰、安静的空间里。" FontSize="15" Foreground="{ThemeResource SakanaMutedBrush}" />
            </StackPanel>

            <Border CornerRadius="20" Padding="30" Background="{ThemeResource SakanaSurfaceBrush}" BorderBrush="{ThemeResource SakanaStrokeBrush}" BorderThickness="1">
                <Grid ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="260" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Spacing="12" VerticalAlignment="Center">
                        <Border Background="{ThemeResource SakanaAccentSoftBrush}" CornerRadius="8" Padding="10,5" HorizontalAlignment="Left">
                            <TextBlock Text="VANILLA · FABRIC" FontSize="11" FontWeight="SemiBold" CharacterSpacing="90" Foreground="{ThemeResource SakanaAccentBrush}" />
                        </Border>
                        <TextBlock Text="你的下一段冒险，&#10;从这里开始。" FontSize="34" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{ThemeResource SakanaTextBrush}" />
                        <TextBlock Text="创建独立实例，选择原版或 Fabric，安装匹配的游戏文件与 Java 运行时，再连接 Minecraft Java 账户开始游戏。" FontSize="15" TextWrapping="Wrap" Foreground="{ThemeResource SakanaMutedBrush}" MaxWidth="560" />
                        <Button Content="创建实例配置" Click="CreateProfile_Click" HorizontalAlignment="Left" Padding="18,10" Style="{ThemeResource AccentButtonStyle}" FontWeight="SemiBold" />
                    </StackPanel>

                    <Grid Grid.Column="1" Grid.RowSpan="3" MinHeight="220">
                        <Ellipse Width="260" Height="260" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="{ThemeResource SakanaAccentSoftBrush}" Opacity="0.9" />
                        <Ellipse Width="184" Height="184" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="{ThemeResource SakanaAccentBrush}" Opacity="0.22" />
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="-8">
                            <TextBlock Text="S" FontSize="132" FontWeight="Light" HorizontalAlignment="Center" Foreground="{ThemeResource SakanaAccentBrush}" />
                            <TextBlock Text="S A K A N A" FontSize="12" FontWeight="SemiBold" CharacterSpacing="260" HorizontalAlignment="Center" Foreground="{ThemeResource SakanaTextBrush}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <InfoBar x:Name="LoadErrorInfoBar" IsOpen="False" Severity="Error" Title="首页数据加载失败" Message="无法读取实例配置或启动记录。请检查本地数据目录，并查看 Sakana 日志。" />

            <Grid ColumnSpacing="18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>
                <Border Padding="22" CornerRadius="16" Background="{ThemeResource SakanaSurfaceBrush}" BorderBrush="{ThemeResource SakanaStrokeBrush}" BorderThickness="1">
                    <StackPanel Spacing="16">
                        <Grid>
                            <StackPanel Spacing="3">
                                <TextBlock Text="实例概览" FontSize="20" FontWeight="SemiBold" Foreground="{ThemeResource SakanaTextBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.ProfileCountText, Mode=OneWay}" FontSize="13" Foreground="{ThemeResource SakanaMutedBrush}" />
                            </StackPanel>
                            <Button Content="打开实例库" Click="OpenLibrary_Click" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                        <Border x:Name="EmptyProfilesState" Padding="16" CornerRadius="10" Background="{ThemeResource SakanaSurfaceRaisedBrush}">
                            <TextBlock Text="还没有实例配置。创建一个配置，开始整理你的游戏版本。" TextWrapping="Wrap" Foreground="{ThemeResource SakanaMutedBrush}" />
                        </Border>
                        <ItemsControl x:Name="ProfileItems" ItemsSource="{x:Bind ViewModel.Profiles, Mode=OneWay}" Visibility="Collapsed">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="10" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="domain:InstanceProfile">
                                    <Border Padding="14" CornerRadius="10" Background="{ThemeResource SakanaSurfaceRaisedBrush}">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="42" Height="42" CornerRadius="10" Background="{ThemeResource SakanaAccentSoftBrush}">
                                                <TextBlock Text="✦" FontSize="19" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource SakanaAccentBrush}" />
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Text="{x:Bind Name}" FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource SakanaTextBrush}" />
                                                <TextBlock Text="{x:Bind VersionId}" FontSize="12" Foreground="{ThemeResource SakanaMutedBrush}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="配置待安装" VerticalAlignment="Center" FontSize="12" Foreground="{ThemeResource SakanaMutedBrush}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Padding="22" CornerRadius="16" Background="{ThemeResource SakanaSurfaceBrush}" BorderBrush="{ThemeResource SakanaStrokeBrush}" BorderThickness="1">
                    <StackPanel Spacing="14">
                        <TextBlock Text="准备就绪" FontSize="20" FontWeight="SemiBold" Foreground="{ThemeResource SakanaTextBrush}" />
                        <TextBlock Text="Sakana 正在搭建你的独立游戏库。" FontSize="14" TextWrapping="Wrap" Foreground="{ThemeResource SakanaMutedBrush}" />
                        <Border Height="1" Background="{ThemeResource SakanaStrokeBrush}" />
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Ellipse Width="8" Height="8" Fill="{ThemeResource SakanaAccentBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="本地数据已启用" FontSize="13" Foreground="{ThemeResource SakanaTextBrush}" />
                        </StackPanel>
                        <TextBlock Text="你的设置和实例配置保存在此设备上。" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource SakanaMutedBrush}" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid ColumnSpacing="18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>
                <Border Padding="22" CornerRadius="16" Background="{ThemeResource SakanaSurfaceBrush}" BorderBrush="{ThemeResource SakanaStrokeBrush}" BorderThickness="1">
                    <StackPanel Spacing="14">
                        <Grid>
                            <StackPanel Spacing="3">
                                <TextBlock Text="最近启动" FontSize="20" FontWeight="SemiBold" Foreground="{ThemeResource SakanaTextBrush}" />
                                <TextBlock Text="最近 12 次游戏运行记录" FontSize="13" Foreground="{ThemeResource SakanaMutedBrush}" />
                            </StackPanel>
                            <Button Content="查看实例库" Click="OpenLibrary_Click" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                        <Border x:Name="HistoryEmptyState" Padding="16" CornerRadius="10" Background="{ThemeResource SakanaSurfaceRaisedBrush}">
                            <TextBlock Text="还没有启动记录。连接 Microsoft 账户并启动 Minecraft 后，最近运行情况会显示在这里。" TextWrapping="Wrap" Foreground="{ThemeResource SakanaMutedBrush}" />
                        </Border>
                        <ItemsControl x:Name="HistoryItems" ItemsSource="{x:Bind ViewModel.RecentLaunches, Mode=OneWay}" Visibility="Collapsed">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="8" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="viewModels:LaunchHistoryCardViewModel">
                                    <Border Padding="12" CornerRadius="10" Background="{ThemeResource SakanaSurfaceRaisedBrush}">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="38" Height="38" CornerRadius="11" Background="{ThemeResource SakanaAccentSoftBrush}">
                                                <SymbolIcon Symbol="Play" Foreground="{ThemeResource SakanaAccentBrush}" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                                <Grid ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{x:Bind InstanceName}" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource SakanaTextBrush}" />
                                                    <TextBlock Grid.Column="1" Text="{x:Bind StatusText}" FontSize="12" Foreground="{ThemeResource SakanaAccentBrush}" />
                                                </Grid>
                                                <TextBlock Text="{x:Bind VersionText}" FontSize="12" Foreground="{ThemeResource SakanaMutedBrush}" />
                                                <TextBlock Text="{x:Bind StartedAtText}" FontSize="11" Foreground="{ThemeResource SakanaMutedBrush}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Padding="22" CornerRadius="16" Background="{ThemeResource SakanaSurfaceBrush}" BorderBrush="{ThemeResource SakanaStrokeBrush}" BorderThickness="1">
                    <StackPanel Spacing="14">
                        <StackPanel Spacing="3">
                            <TextBlock Text="运行中的游戏" FontSize="20" FontWeight="SemiBold" Foreground="{ThemeResource SakanaTextBrush}" />
                            <TextBlock Text="实时进程状态" FontSize="13" Foreground="{ThemeResource SakanaMutedBrush}" />
                        </StackPanel>
                        <Border x:Name="ActiveProcessEmptyState" Padding="16" CornerRadius="10" Background="{ThemeResource SakanaSurfaceRaisedBrush}">
                            <TextBlock Text="当前没有运行中的 Minecraft 进程。" TextWrapping="Wrap" Foreground="{ThemeResource SakanaMutedBrush}" />
                        </Border>
                        <ItemsControl x:Name="ActiveProcessItems" ItemsSource="{x:Bind ViewModel.ActiveProcesses, Mode=OneWay}" Visibility="Collapsed">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="8" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="viewModels:ActiveGameProcessViewModel">
                                    <Border Padding="14" CornerRadius="10" Background="{ThemeResource SakanaSurfaceRaisedBrush}">
                                        <StackPanel Spacing="6">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Ellipse Width="8" Height="8" Fill="{ThemeResource SakanaAccentBrush}" VerticalAlignment="Center" />
                                                <TextBlock Text="正在运行" FontSize="12" Foreground="{ThemeResource SakanaAccentBrush}" />
                                            </StackPanel>
                                            <TextBlock Text="{x:Bind VersionText}" FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource SakanaTextBrush}" />
                                            <TextBlock Text="{x:Bind ProcessIdText}" FontSize="12" Foreground="{ThemeResource SakanaMutedBrush}" />
                                            <TextBlock Text="{x:Bind StartedAtText}" FontSize="12" Foreground="{ThemeResource SakanaMutedBrush}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
