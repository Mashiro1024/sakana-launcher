<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="SakanaCanvasBrush" Color="#FF0B0E15" />
            <SolidColorBrush x:Key="SakanaSurfaceBrush" Color="#FF151A24" />
            <SolidColorBrush x:Key="SakanaSurfaceRaisedBrush" Color="#FF1C2230" />
            <SolidColorBrush x:Key="SakanaStrokeBrush" Color="#FF303747" />
            <SolidColorBrush x:Key="SakanaTextBrush" Color="#FFF4F6FC" />
            <SolidColorBrush x:Key="SakanaMutedBrush" Color="#FF9BA6B8" />
            <SolidColorBrush x:Key="SakanaAccentBrush" Color="#FF8A9AFF" />
            <SolidColorBrush x:Key="SakanaAccentFillBrush" Color="#FF465BDC" />
            <SolidColorBrush x:Key="SakanaAccentSoftBrush" Color="#FF242C49" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="SakanaCanvasBrush" Color="#FFF4F6FA" />
            <SolidColorBrush x:Key="SakanaSurfaceBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="SakanaSurfaceRaisedBrush" Color="#FFE9EDF5" />
            <SolidColorBrush x:Key="SakanaStrokeBrush" Color="#FFD9DEEA" />
            <SolidColorBrush x:Key="SakanaTextBrush" Color="#FF18202F" />
            <SolidColorBrush x:Key="SakanaMutedBrush" Color="#FF5F6B7D" />
            <SolidColorBrush x:Key="SakanaAccentBrush" Color="#FF465BDC" />
            <SolidColorBrush x:Key="SakanaAccentFillBrush" Color="#FF465BDC" />
            <SolidColorBrush x:Key="SakanaAccentSoftBrush" Color="#FFE8EBFF" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Default">
            <SolidColorBrush x:Key="SakanaCanvasBrush" Color="#FF0B0E15" />
            <SolidColorBrush x:Key="SakanaSurfaceBrush" Color="#FF151A24" />
            <SolidColorBrush x:Key="SakanaSurfaceRaisedBrush" Color="#FF1C2230" />
            <SolidColorBrush x:Key="SakanaStrokeBrush" Color="#FF303747" />
            <SolidColorBrush x:Key="SakanaTextBrush" Color="#FFF4F6FC" />
            <SolidColorBrush x:Key="SakanaMutedBrush" Color="#FF9BA6B8" />
            <SolidColorBrush x:Key="SakanaAccentBrush" Color="#FF8A9AFF" />
            <SolidColorBrush x:Key="SakanaAccentFillBrush" Color="#FF465BDC" />
            <SolidColorBrush x:Key="SakanaAccentSoftBrush" Color="#FF242C49" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
